# Copy this file to .env and fill it in. .env is ignored by git: never commit it.

# Folder holding roms/, media/, saves/, savestates/ (the last two optional).
# RetroManager also creates inbox/, retromanager/ and save-backups/ here.
RETRO_DIR=/path/to/RetroGames

# Port to open RetroManager on
RETROMANAGER_PORT=5000

# Optional: per-person folders inside saves/ and savestates/, comma separated
# (e.g. saves/alice/snes/...). Leave empty if saves aren't split by person.
SAVE_PROFILES=

# ScreenScraper developer credentials. Request your own developer access on the
# screenscraper.fr forum; each app needs its own.
SCREENSCRAPER_LOGIN=
SCREENSCRAPER_PASSWORD=
SCREENSCRAPER_DEBUG_PASSWORD=

# Optional: your ScreenScraper user account, for a bigger daily quota and access
# when ScreenScraper closes the API to non-members.
SCREENSCRAPER_USER=
SCREENSCRAPER_USER_PASSWORD=

# IGDB (via a Twitch application: https://dev.twitch.tv/console/apps)
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Optional: extra series names that get a colon after them in the Name style
# fix, comma separated
NAME_STYLE_SERIES=
