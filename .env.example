# None of this is needed to start: without a .env file the library is a folder
# called RetroGames beside docker-compose.yml. Copy this to .env only to use
# folders you already have, or another port. docker compose reads .env from
# this folder.

# The folder on this machine that holds roms/, media/, saves/, savestates/,
# BIOS/, inbox/, save-backups/ and retromanager/ (RetroManager's own files)
#RETRO_DIR=/path/to/RetroGames

# Any of those that's somewhere else has a line of its own, which is used
# instead of the one inside RETRO_DIR. Leave the rest out.
#ROMS_DIR=/volume1/games/roms
#MEDIA_DIR=/volume1/games/downloaded_media
#SAVES_DIR=/volume2/sync/saves
#SAVESTATES_DIR=/volume2/sync/states
#BIOS_DIR=/volume1/games/bios
#INBOX_DIR=/volume1/downloads/roms-inbox
#RETROMANAGER_DIR=/volume1/docker/retromanager
#SAVE_BACKUPS_DIR=/volume1/backups/saves

# The port RetroManager is opened at on this machine
#PORT=5000

# People to start with, each with a folder of their own inside saves/ and
# savestates/. Usually left out: saves are shared until people are added in the
# app (Tools > Profiles and login), which is also where to add more later.
#SAVE_PROFILES=alice,bob
