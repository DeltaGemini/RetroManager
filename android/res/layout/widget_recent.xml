<?xml version="1.0" encoding="utf-8"?>
<!-- The recent games widget (RecentWidget): a heading over up to five games. Every name has two
     lines and every picture fills its slot, so the pictures are all the same height -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:background="@drawable/widget_bg" android:padding="10dp">
    <TextView android:id="@+id/heading" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Continue playing" android:textColor="#FF6B9D" android:textSize="13sp" android:textStyle="bold"
        android:paddingStart="4dp" android:paddingBottom="6dp" />
    <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent"
        android:gravity="center" android:text="Open RetroManager to see the games you've played." android:textColor="#B8B8C2"
        android:textSize="12sp" android:visibility="gone" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:orientation="horizontal">
        <LinearLayout android:id="@+id/slot0" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:padding="3dp" android:visibility="gone">
            <ImageView android:id="@+id/art0" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:scaleType="centerCrop" android:contentDescription="@null" />
            <TextView android:id="@+id/name0" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:gravity="center_horizontal|top" android:lines="2" android:ellipsize="end"
                android:textColor="#F2F2F7" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot1" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:padding="3dp" android:visibility="gone">
            <ImageView android:id="@+id/art1" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:scaleType="centerCrop" android:contentDescription="@null" />
            <TextView android:id="@+id/name1" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:gravity="center_horizontal|top" android:lines="2" android:ellipsize="end"
                android:textColor="#F2F2F7" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot2" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:padding="3dp" android:visibility="gone">
            <ImageView android:id="@+id/art2" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:scaleType="centerCrop" android:contentDescription="@null" />
            <TextView android:id="@+id/name2" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:gravity="center_horizontal|top" android:lines="2" android:ellipsize="end"
                android:textColor="#F2F2F7" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot3" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:padding="3dp" android:visibility="gone">
            <ImageView android:id="@+id/art3" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:scaleType="centerCrop" android:contentDescription="@null" />
            <TextView android:id="@+id/name3" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:gravity="center_horizontal|top" android:lines="2" android:ellipsize="end"
                android:textColor="#F2F2F7" android:textSize="11sp" />
        </LinearLayout>
        <LinearLayout android:id="@+id/slot4" android:layout_width="0dp" android:layout_height="match_parent"
            android:layout_weight="1" android:orientation="vertical" android:padding="3dp" android:visibility="gone">
            <ImageView android:id="@+id/art4" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
                android:scaleType="centerCrop" android:contentDescription="@null" />
            <TextView android:id="@+id/name4" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:layout_marginTop="3dp" android:gravity="center_horizontal|top" android:lines="2" android:ellipsize="end"
                android:textColor="#F2F2F7" android:textSize="11sp" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
